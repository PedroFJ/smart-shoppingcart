{
  "expo": {
    "name": "Smart Shoppingcart",
    "slug": "smart-shoppingcart",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "smart-shoppingcart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedrofreire.smartshoppingcart",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.pedrofreire.smartshoppingcart",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F5F7F9"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que a Smart Shoppingcart use o microfone para pesquisa por voz.",
          "speechRecognitionPermission": "Permitir que a Smart Shoppingcart use reconhecimento de voz para pesquisa."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f639a2e0-4dee-4b8c-b070-eaf2e26f8b3c"
      }
    },
    "owner": "pedrofj",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f639a2e0-4dee-4b8c-b070-eaf2e26f8b3c"
    }
  }
}
